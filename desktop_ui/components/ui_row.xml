<component>
	<previews>
		<preview name="default" width="300" style_bg_color="#color_panel" style_pad_all="8" />
	</previews>

	<api>
		<prop name="gap" type="int" default="#space_md" help="Space between the children" />
		<prop name="main" type="enum:lv_flex_align" default="start" help="Distribution along the row" />
		<prop name="cross" type="enum:lv_flex_align" default="center" help="Alignment across the row" />
	</api>

	<!-- Transparent full-width row. Layout glue only: no background, no padding. -->
	<view
		extends="lv_obj"
		width="100%"
		height="content"
		flex_flow="row"
		style_pad_all="0"
		style_pad_column="$gap"
		style_bg_opa="0"
		style_border_width="0"
		style_flex_main_place="$main"
		style_flex_cross_place="$cross"
		scrollable="false"
		scrollbar_mode="off"
	/>
</component>

<component>
	<previews>
		<preview name="default" width="380" height="470" style_bg_color="#color_bg" style_pad_all="16" />
	</previews>

	<styles>
		<style
			name="style_input"
			bg_color="#color_inset"
			text_color="#color_text"
			bg_opa="100%"
			border_color="#color_border"
			border_width="1"
			radius="#radius_sm"
			pad_hor="#space_md"
		/>
		<style name="style_placeholder" text_color="#color_muted" />
		<style name="style_cursor" bg_color="#color_border" bg_opa="100%" />
	</styles>

	<!-- (6) Transcript + composer. The transcript is a bound label inside a
	     scroller rather than a text area, because lv_textarea has no text
	     binding: the application owns chat_log and just rewrites the string.
	     Sending does NOT append locally - the message only appears once the
	     application has echoed it back into chat_log. -->
	<view extends="ui_panel" title="CHAT" gap="#space_sm" width="100%" height="100%">
		<lv_obj name="log" width="100%" flex_grow="1" style_pad_all="#space_md" scrollbar_mode="auto">
			<style name="style_inset" />
			<style name="style_scrollbar" selector="scrollbar" />
			<lv_label name="log_text" width="100%" long_mode="wrap" bind_text="chat_log">
				<style name="style_small_body" />
			</lv_label>
		</lv_obj>

		<ui_row gap="#space_sm" cross="center">
			<lv_textarea name="chat_input" flex_grow="1" height="40" one_line="true" placeholder_text="Write a message">
				<style name="style_input" />
				<style name="style_placeholder" selector="textarea_placeholder" />
				<style name="style_cursor" selector="cursor" />
				<event_cb callback="ui_chat_send" trigger="ready" />
			</lv_textarea>

			<!-- The callback only moves the composer's text into
			     cmd_chat_message and clears the field; it never touches
			     chat_log. cmd_chat_send is bumped afterwards so the application
			     has a single edge to observe. -->
			<ui_button name="send" text="Send" width="content">
				<event_cb callback="ui_chat_send" trigger="clicked" />
			</ui_button>
		</ui_row>
	</view>
</component>

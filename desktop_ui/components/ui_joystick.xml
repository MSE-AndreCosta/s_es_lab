<component>
	<previews>
		<preview name="default" width="1280" height="720" style_bg_color="#color_bg" style_pad_all="16" />
	</previews>

	<styles>
		<style name="style_guide" bg_color="#color_border" bg_opa="100%" border_width="0" />
		<style name="style_axis_bar" bg_color="#color_track" bg_opa="100%" radius="3" />
	</styles>

	<!-- (3b) Live joystick position. joy_x / joy_y are the knob's pixel offset
	     from the center of the pad, -46..46, so they map straight onto
	     translate_x / translate_y with no maths in the UI. -->
	<view extends="ui_panel" title="JOYSTICK" width="100%" height="100%">
		<lv_obj
			name="pad"
			width="100%"
			height="60%"
			align="center"
			style_align="center"
			style_radius="70"
			style_pad_all="0"
			scrollable="false"
			scrollbar_mode="off"
		>
			<style name="style_inset" />

			<lv_obj name="guide_h" width="100%" height="1" align="center">
				<style name="style_guide" />
			</lv_obj>
			<lv_obj name="guide_v" width="1" height="100%" align="center">
				<style name="style_guide" />
			</lv_obj>

			<lv_obj
				name="knob"
				width="34"
				height="34"
				align="center"
				style_radius="17"
				style_bg_color="#color_green"
				style_bg_opa="100%"
				style_border_width="0"
				style_shadow_width="18"
				style_shadow_color="#color_green"
				style_pad_all="0"
				scrollable="false"
			>
				<bind_style_prop prop="translate_x" subject="joy_x" />
				<bind_style_prop prop="translate_y" subject="joy_y" />
			</lv_obj>
		</lv_obj>

		<!-- Numeric readout of the same two subjects, with a symmetrical bar so
		     the deflection is visible at a glance. -->
		<ui_row main="space_between">
			<lv_label name="x_label" bind_text="joy_x" bind_text-fmt="X %d">
				<style name="style_label_small" />
			</lv_label>
			<lv_label name="y_label" bind_text="joy_y" bind_text-fmt="Y %d">
				<style name="style_label_small" />
			</lv_label>
		</ui_row>

		<lv_bar
			name="x_bar"
			width="100%"
			height="6"
			mode="symmetrical"
			min_value="-46"
			max_value="46"
			bind_value="joy_x"
			style_bg_color-indicator="#color_green"
			style_radius-indicator="3"
		>
			<style name="style_axis_bar" />
		</lv_bar>

		<lv_bar
			name="y_bar"
			width="100%"
			height="6"
			mode="symmetrical"
			min_value="-46"
			max_value="46"
			bind_value="joy_y"
			style_bg_color-indicator="#color_green"
			style_radius-indicator="3"
		>
			<style name="style_axis_bar" />
		</lv_bar>
	</view>
</component>
